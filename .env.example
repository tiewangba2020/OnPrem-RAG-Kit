# ==============================================================================
# OnPrem-RAG-Kit 环境配置示例
# 复制为 .env 后按需填写；**全部留空也能运行**（自动进入高保真演示模式 Demo Mode）
# ==============================================================================

# ------------------------------------------------------------------------------
# LLM 推理后端：demo | ollama | vllm | deepseek | qwen | openai
#   demo     —— 不调用任何外部服务，使用抽取式作答器（默认，零配置可用）
#   ollama   —— 本地 Ollama，默认 http://localhost:11434/v1
#   vllm     —— 本地 vLLM OpenAI 兼容服务，默认 http://localhost:8000/v1
#   deepseek —— DeepSeek 云端 API（需填 LLM_API_KEY）
#   qwen     —— 阿里云通义千问兼容模式（需填 LLM_API_KEY）
#   openai   —— OpenAI（需填 LLM_API_KEY）
# ------------------------------------------------------------------------------
LLM_PROVIDER=demo

# 若使用自定义网关/私有化端点，可显式覆盖以下三项
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_API_KEY=EMPTY
# LLM_MODEL=Qwen2.5-32B-Instruct-AWQ

LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# ------------------------------------------------------------------------------
# 向量嵌入：offline | api
#   offline —— 内置离线 TF-IDF 哈希向量（无需 GPU / 无需下载模型，默认）
#   api     —— 调用 OpenAI 兼容 /embeddings 接口（vLLM / Ollama / 云端均可）
# ------------------------------------------------------------------------------
EMBEDDING_PROVIDER=offline
EMBEDDING_MODEL=bge-m3

# ------------------------------------------------------------------------------
# 重排器：heuristic | bge
#   heuristic —— 内置可解释领域重排器（离线，默认）
#   bge       —— BAAI/bge-reranker-v2-m3（需 pip install sentence-transformers）
# ------------------------------------------------------------------------------
RERANKER_PROVIDER=heuristic
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ------------------------------------------------------------------------------
# 企业内部部署参考（按需取消注释）
# ------------------------------------------------------------------------------
# LLM_PROVIDER=vllm
# LLM_BASE_URL=http://10.0.12.31:8000/v1
# LLM_MODEL=Qwen2.5-32B-Instruct-AWQ
# EMBEDDING_PROVIDER=api
# EMBEDDING_MODEL=/models/bge-m3
# RERANKER_PROVIDER=bge
